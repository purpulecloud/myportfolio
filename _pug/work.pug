extends _layout

block vars
  - var pageTitle = 'Work'
  - var pageDescription = 'A collection of Lynn Fisher’s weird web projects including A Single Div, Dress David Rose, and Nestflix.'
  - var pagePath = 'work'
  - var bodyClass = 'work'

block header

  p.chapter II
  h1#content Work

block content

  ul.archive-list
    li.project.sign-language
      .links
        small: a(href='https://github.com/purpulecloud') Sign Language Detection — Developed a deep learning system using MediaPipe and a CNN-based classifier
        small: a(href='https://github.com/purpulecloud') purpulecloud
    li.project.assistive-nurse-robot
      .links
        small: a(href='https://github.com/purpulecloud') Assistive Nurse Robot — Healthcare robot with MediaPipe face detection, centroid tracking, Raspberry Pi and Arduino integration
        small: a(href='https://github.com/purpulecloud') purpulecloud
    li.project.ai-deck
      .links
        small: a(href='https://github.com/purpulecloud') AI Deck — Web interface for browsing and discovering AI tools by use case
        small: a(href='https://github.com/purpulecloud') purpulecloud
    li.project.genome-prediction
      .links
        small: a(href='https://github.com/purpulecloud') Genome-Wide Prediction — CLIP/ChIP-based model for predicting problematic DNA/RNA binding sites
        small: a(href='https://github.com/purpulecloud') purpulecloud
    li.project.agri-robot
      .links
        small: a(href='https://github.com/purpulecloud') Agriculture Support Robot — Raspberry Pi skid-drive robot with path retracking and displacement correction
        small: a(href='https://github.com/purpulecloud') purpulecloud
