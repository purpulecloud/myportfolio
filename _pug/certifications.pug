extends _layout

block vars
  - var pageTitle = 'Certifications'
  - var pageDescription = 'Professional and course certifications'
  - var pagePath = 'certifications'
  - var bodyClass = 'certifications'

block header
  p.chapter III
  h1#content Certifications

block content
  .container
    .content
